{
  "name": "leadflow-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:check": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test:mock": "tsx --tsconfig tsconfig.app.json tests/mock-api.smoke.ts",
    "test:contract": "tsx tests/backend-contract.check.ts",
    "contract:update": "node -e \"fetch(process.env.API_SCHEMA_URL,{headers:{'ngrok-skip-browser-warning':'1',Accept:'application/json'}}).then(r=>r.text()).then(t=>require('fs').writeFileSync('contracts/leadflow-openapi.json',t))\""
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@iconify/vue": "^5.0.3",
    "@primevue/auto-import-resolver": "^4.5.4",
    "@primevue/themes": "^4.5.4",
    "@tanstack/vue-query": "^5.92.8",
    "moment": "^2.30.1",
    "pinia": "^3.0.4",
    "primevue": "^4.5.4",
    "unplugin-vue-components": "^31.0.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.27",
    "vue-i18n": "^11.2.2",
    "vue-router": "^4.6.4",
    "vue3-toastify": "^0.2.8",
    "vuedraggable": "^4.1.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.23",
    "jiti": "^2.6.1",
    "postcss": "^8.5.6",
    "sass": "^1.97.2",
    "sass-loader": "^16.0.6",
    "tailwindcss": "^3.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^6.0.5",
    "vue-tsc": "^3.1.4"
  }
}
