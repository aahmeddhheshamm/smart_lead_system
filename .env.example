# ---------------------------------------------------------------------------
# LeadFlow web — environment
# ---------------------------------------------------------------------------

# API base used by the browser, including /api/v1/ and a trailing slash.
#   Development with the proxy below: /api/v1/
#   Production: https://api.your-domain.com/api/v1/
VITE_APP_API_URL=/api/v1/

# Development only: where the Vite dev server forwards /api/* (the Django backend).
# Use this for ngrok / remote backends — it avoids CORS and ngrok's browser warning page.
VITE_DEV_PROXY_TARGET=https://your-backend.ngrok-free.app

# Absolute API URL shown to website developers (webhook ingest URL in Integrations).
# Defaults to VITE_APP_API_URL when that is already absolute.
VITE_PUBLIC_API_URL=https://your-backend.ngrok-free.app/api/v1/

# true = in-browser mock API with demo data (src/mock); false = real backend.
VITE_USE_MOCK=false
