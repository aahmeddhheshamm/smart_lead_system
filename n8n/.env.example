# Copy to n8n/.env (ignored by git).

# Public HTTPS URL of this n8n (your ngrok address), with a trailing slash.
# Free ngrok URLs change on every restart: update this and restart n8n, or use a free static ngrok domain.
WEBHOOK_URL=https://your-n8n.ngrok-free.app/

# Keep stable forever; losing it makes stored credentials unreadable.
N8N_ENCRYPTION_KEY=

GENERIC_TIMEZONE=UTC
